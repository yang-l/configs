{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "85",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_ENABLE_AWAY_SUMMARY": "1",
    "ENABLE_PROMPT_CACHING_1H": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_SUPPRESS_SESSION_ATTRIBUTION": "1"
  },
  "includeCoAuthoredBy": false,
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(git stash:*)",
      "Bash(ls:*)",
      "Bash(which:*)",
      "mcp__emacs-tools__*",
      "mcp__sequentialthinking__*"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(rm -rf:*)",
      "Read(~/.ejson/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(//**/node_modules/)",
      "Read(//**/dist/)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Read(//**/*.pem)",
      "Read(//**/*.key)"
    ]
  },
  "model": "opus[1m]",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' 'Reply contract (Lean): tier line, then the answer. No preamble, no opening praise, no self-grading, no closing summary. Keep risks, mistakes, guesses, and exact values. ISO 24495-1 governs every reply: give only what the reader needs (relevant), structure it and put the point where they look first (findable), use familiar words and a respectful tone (understandable), and check it answers every part of the question (usable).' 'If this turn produces a deliverable (any text with a reader beyond this chat), apply ASD-STE100: one instruction per sentence, maximum 20 words for an instruction and 25 for description, no semicolons, no phrasal verbs, active voice with a named actor, simple tenses unless the compound form carries current relevance or a hedge, the verb not the noun form, noun clusters of three words or fewer. Run it through the asd-ste100 skill before returning it. Never drop a fact, number, scope qualifier, or hedge to meet a cap. A conversational reply is exempt from ASD-STE100, not from ISO 24495-1.'; exit 0"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; npx -y prettier@3.7.4 --write --ignore-unknown \"$f\"; } 2>/dev/null",
            "continueOnBlock": true
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enabledPlugins": {
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "outputStyle": "Lean",
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "allowWrite": ["/dev/ptmx", "/dev/ttys*"]
    },
    "excludedCommands": [
      "bundle exec rspec *",
      "gh *",
      "git *",
      "terraform *",
      "node *codex-companion.mjs*"
    ]
  },
  "spinnerTipsEnabled": false,
  "alwaysThinkingEnabled": true,
  "effortLevel": "medium",
  "advisorModel": "fable",
  "promptSuggestionEnabled": false,
  "autoUpdatesChannel": "stable",
  "autoMemoryEnabled": true,
  "skipWorkflowUsageWarning": true,
  "teammateMode": "in-process",
  "remoteControlAtStartup": false,
  "skipAutoPermissionPrompt": true,
  "autoInstallIdeExtension": false,
  "gitAttribution": false
}
